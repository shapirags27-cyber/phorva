<script>
(() => {
  const $ = (id) => document.getElementById(id);

  async function api(path, options = {}) {
    const response = await fetch(path, {
      ...options,
      headers: {
        "Content-Type": "application/json",
        ...(options.headers || {})
      }
    });

    let data;
    try {
      data = await response.json();
    } catch {
      data = { error: await response.text() };
    }

    if (!response.ok) {
      throw new Error(data.error || `Request failed: ${response.status}`);
    }

    return data;
  }

  function setText(id, value) {
    const el = $(id);
    if (el) el.textContent = value ?? "—";
  }

  function parseJSON(id) {
    const value = $(id).value.trim();
    if (!value) return {};
    return JSON.parse(value);
  }

  async function loadExecutionContext() {
    try {
      const [chains, protocols, assets] = await Promise.all([
        api("/api/chains"),
        api("/api/protocols"),
        api("/api/assets")
      ]);

      const chainSelect = $("executionChain");
      chainSelect.innerHTML = "";

      for (const chain of chains) {
        const option = document.createElement("option");
        option.value = chain.key;
        option.textContent = `${chain.name} (${chain.chainId})`;
        chainSelect.appendChild(option);
      }

      function loadProtocols() {
        const chain = chainSelect.value;
        const select = $("executionProtocol");

        select.innerHTML =
          '<option value="">No protocol / direct execution</option>';

        for (const protocol of (protocols[chain] || [])) {
          const option = document.createElement("option");
          option.value = protocol;
          option.textContent = protocol;
          select.appendChild(option);
        }
      }

      function loadAssets() {
        const chain = chainSelect.value;
        const select = $("executionAsset");

        select.innerHTML =
          '<option value="">Select asset</option>';

        for (const asset of (assets[chain] || [])) {
          const option = document.createElement("option");
          option.value = asset.address || "";
          option.textContent =
            `${asset.symbol || asset.name || "Asset"} — ${asset.name || asset.address || ""}`;
          option.dataset.symbol = asset.symbol || "";
          option.dataset.name = asset.name || "";
          select.appendChild(option);
        }
      }

      chainSelect.addEventListener("change", () => {
        loadProtocols();
        loadAssets();
        syncJSON();
      });

      $("executionType").addEventListener("change", syncJSON);
      $("executionProtocol").addEventListener("change", syncJSON);
      $("executionAsset").addEventListener("change", syncJSON);

      loadProtocols();
      loadAssets();
      syncJSON();

    } catch (error) {
      console.error("PHORVA context load failed:", error);
    }
  }

  function syncJSON() {
    const chain = $("executionChain")?.value || "";
    const type = $("executionType")?.value || "";
    const protocol = $("executionProtocol")?.value || "";
    const asset = $("executionAsset")?.value || "";

    let intent = {};
    try {
      intent = JSON.parse($("intentJson").value || "{}");
    } catch {}

    intent.executionType = type;
    intent.chain = chain;

    if (protocol) intent.protocol = protocol;
    if (asset) intent.assetAddress = asset;

    $("intentJson").value = JSON.stringify(intent, null, 2);

    let transaction = {};
    try {
      transaction = JSON.parse($("transactionJson").value || "{}");
    } catch {}

    transaction.chain = chain;

    if (!("value" in transaction)) transaction.value = "0";
    if (!("data" in transaction)) transaction.data = "0x";

    $("transactionJson").value =
      JSON.stringify(transaction, null, 2);
  }

  async function evaluateExecution() {
    const button = $("evaluateExecution");
    button.disabled = true;
    button.textContent = "Evaluating…";

    try {
      const agent = {
        id: $("agentId").value.trim(),
        walletAddress: $("agentWallet").value.trim()
      };

      const action = {
        executionType: $("executionType").value
      };

      const intent = parseJSON("intentJson");
      const policy = parseJSON("policyJson");
      const transaction = parseJSON("transactionJson");

      const result = await api("/authorize", {
        method: "POST",
        body: JSON.stringify({
          agent,
          action,
          intent,
          policy,
          transaction
        })
      });

      renderAuthorization(result);

    } catch (error) {
      renderAuthorizationError(error);
    } finally {
      button.disabled = false;
      button.textContent = "Evaluate Execution";
    }
  }

  function renderAuthorization(result) {
    const authorized = result.authorized === true;

    setText(
      "verdictTitle",
      authorized ? "Execution authorized" : "Execution blocked"
    );

    const badge = $("verdictBadge");
    badge.textContent = authorized ? "AUTHORIZED" : "BLOCKED";
    badge.className =
      "status-badge " + (authorized ? "success" : "danger");

    setText(
      "vPolicy",
      result.policyPassed ? "PASSED" : "FAILED"
    );

    setText(
      "vIntent",
      result.intentMatched ? "MATCHED" : "MISMATCH"
    );

    setText(
      "vParameters",
      result.parameterMatched ? "MATCHED" : "MISMATCH"
    );

    setText(
      "vExecutionType",
      result.executionTypeMatched ? "MATCHED" : "MISMATCH"
    );

    setText(
      "vProtocol",
      result.protocolMatched ? "MATCHED" : "MISMATCH"
    );

    setText(
      "vSecurity",
      result.transactionSecuritySafe ? "SAFE" : "THREAT"
    );

    setText("resultRisk", result.risk || "—");
    setText(
      "resultAuthorized",
      result.authorized ? "YES" : "NO"
    );

    setText(
      "proofAlgorithm",
      result.proof?.algorithm || "—"
    );

    setText(
      "proofCommitment",
      result.proof?.commitment || "—"
    );

    setText(
      "authorizationReason",
      result.reason || "No authorization reason returned."
    );

    $("rawAuthorization").textContent =
      JSON.stringify(result, null, 2);
  }

  function renderAuthorizationError(error) {
    setText("verdictTitle", "Authorization request failed");

    const badge = $("verdictBadge");
    badge.textContent = "ERROR";
    badge.className = "status-badge danger";

    setText("authorizationReason", error.message);

    [
      "vPolicy",
      "vIntent",
      "vParameters",
      "vExecutionType",
      "vProtocol",
      "vSecurity",
      "resultRisk",
      "resultAuthorized",
      "proofAlgorithm",
      "proofCommitment"
    ].forEach(id => setText(id, "—"));

    $("rawAuthorization").textContent =
      JSON.stringify({ error: error.message }, null, 2);
  }

  $("evaluateExecution")?.addEventListener(
    "click",
    evaluateExecution
  );

  $("resetExecution")?.addEventListener(
    "click",
    () => window.location.reload()
  );

  loadExecutionContext();
})();
</script>


