<main class="main">


<!-- HOME -->
<section class="view active" id="home">
  <div class="home-shell">

    <div class="home-hero">
      <div class="kicker">Execution-security infrastructure</div>
      <h1>Verify before autonomous execution.</h1>
      <p>
        PHORVA sits between autonomous agents and blockchain execution.
        It evaluates identity, declared intent, policy, transaction semantics,
        risk and authorization before an action proceeds.
      </p>

      <div class="home-actions">
        <button class="primary" data-view="agent">Open Agent</button>
        <button class="secondary" data-view="verification">View Verification</button>
      </div>

      <div class="home-flow">
        <span class="flow-node">Agent</span>
        <i>→</i>
        <span class="flow-node">Intent</span>
        <i>→</i>
        <span class="flow-node core">Policy</span>
        <i>→</i>
        <span class="flow-node">Risk</span>
        <i>→</i>
        <span class="flow-node">Transaction</span>
        <i>→</i>
        <span class="flow-node core">Authorization</span>
        <i>→</i>
        <span class="flow-node">Execution</span>
      </div>
    </div>

    <div class="home-status-grid">
      <div class="card home-status-card">
        <div class="label">Backend</div>
        <div class="value" id="healthStatus">—</div>
        <div class="meta">PHORVA security engine</div>
      </div>

      <div class="card home-status-card">
        <div class="label">Networks</div>
        <div class="value" id="networkCount">—</div>
        <div class="meta">Configured chains</div>
      </div>

      <div class="card home-status-card">
        <div class="label">Analyzer</div>
        <div class="value analyzer-value" id="analyzerStatus">—</div>
        <div class="meta">Transaction analysis</div>
      </div>
    </div>

    <div class="home-metrics">
      <div class="card home-metric">
        <div class="metric-icon">◇</div>
        <div>
          <div class="label">Agents Protected</div>
          <div class="metric-value" id="homeAgentsProtected">0</div>
          <div class="meta">Agents evaluated by PHORVA</div>
        </div>
      </div>

      <div class="card home-metric">
        <div class="metric-icon">✓</div>
        <div>
          <div class="label">Executions Verified</div>
          <div class="metric-value" id="homeExecutionsVerified">0</div>
          <div class="meta">Authorized execution requests</div>
        </div>
      </div>

      <div class="card home-metric">
        <div class="metric-icon">!</div>
        <div>
          <div class="label">Threats Blocked</div>
          <div class="metric-value" id="homeThreatsBlocked">0</div>
          <div class="meta">Requests rejected by verification</div>
        </div>
      </div>
    </div>

    <div class="home-main-grid">

      <div class="card home-control-card">
        <div class="head">
          <div>
            <strong>Execution Control</strong>
            <div class="muted">
              PHORVA verification pipeline
            </div>
          </div>
          <span class="badge green" id="engineBadge">ONLINE</span>
        </div>

        <div class="control-pipeline">
          <div class="control-step">
            <span>01</span>
            <div>
              <strong>Intent verification</strong>
              <small>Compare declared intent with requested execution.</small>
            </div>
          </div>

          <div class="pipeline-line"></div>

          <div class="control-step">
            <span>02</span>
            <div>
              <strong>Policy enforcement</strong>
              <small>Evaluate limits and permitted execution conditions.</small>
            </div>
          </div>

          <div class="pipeline-line"></div>

          <div class="control-step">
            <span>03</span>
            <div>
              <strong>Transaction analysis</strong>
              <small>Inspect EVM transaction data and parameters.</small>
            </div>
          </div>

          <div class="pipeline-line"></div>

          <div class="control-step">
            <span>04</span>
            <div>
              <strong>Authorization</strong>
              <small>Return an allow or block decision before execution.</small>
            </div>
          </div>
        </div>
      </div>

