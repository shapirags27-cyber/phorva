function setVerdict(id,value){

 const el =
   document.getElementById(id);

 el.textContent =
   value || "—";

 el.className =
   /FAILED|MISMATCH|UNKNOWN|THREAT|BLOCKED/i.test(value || "")
   ? "bad"
   : "ok";

}



function addActivity(data){

 activityEvents.unshift({
   time:new Date().toLocaleTimeString(),
   authorized:data.authorized,
   risk:data.risk,
   reason:data.reason
 });

 const list =
   document.getElementById("activityList");

 list.innerHTML = "";

 activityEvents.slice(0,10).forEach(event => {

   const row =
     document.createElement("div");

   row.className = "row";

   row.innerHTML = `

     <div class="row-icon">
       ${event.authorized ? "✓" : "!"}
     </div>

     <div>
       <strong>
         ${event.authorized ? "Execution authorized" : "Execution blocked"}
       </strong>

       <span>
         Risk ${escapeHtml(event.risk || "UNKNOWN")}
         · ${escapeHtml(event.reason || "")}
       </span>
     </div>

     <div class="time">
       ${escapeHtml(event.time)}
     </div>

   `;

   list.appendChild(row);

 });

}



function escapeHtml(value){

 return String(value)
   .replaceAll("&","&amp;")
   .replaceAll("<","&lt;")
   .replaceAll(">","&gt;")
   .replaceAll('"',"&quot;")
   .replaceAll("'","&#039;");

}



