function getAgentContextRule(){

 const domain =
   document.getElementById("agentDomain")?.value;

 const action =
   document.getElementById("agentAction")?.value;

 return AGENT_CONTEXT_RULES[domain]?.[action] ||
   {protocol:false,asset:"none"};
}

function updateAgentContextFields(){

 const rule = getAgentContextRule();

 const protocolField =
   document.getElementById("agentProtocolField");

 const assetField =
   document.getElementById("agentAssetField");

 if(protocolField)
   protocolField.style.display =
     rule.protocol ? "" : "none";

 if(assetField)
   assetField.style.display =
     rule.asset !== "none" ? "" : "none";

 const protocolSelect =
   document.getElementById("agentProtocol");

 const assetSelect =
   document.getElementById("agentAsset");

 if(protocolSelect)
   protocolSelect.disabled = !rule.protocol;

 if(assetSelect)
   assetSelect.disabled = !rule.asset;

 if(rule.protocol)
   updateProtocols();

 if(rule.asset)
   updateAssets();

}

function updateProtocols(){

 const chain =
   document.getElementById("agentChain").value;

 const select =
   document.getElementById("agentProtocol");

 select.innerHTML = "";

 const list = protocols[chain] || [];

 list.forEach(protocol => {

   const option = document.createElement("option");

   option.value = protocol;

   option.textContent = protocol;

   select.appendChild(option);

 });

 if(!list.length){

   const option = document.createElement("option");

   option.value = "";

   option.textContent = "No registered protocol";

   select.appendChild(option);

 }

}



