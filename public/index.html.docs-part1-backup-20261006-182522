<script id="phorva-functional-core">
(() => {
  "use strict";

  /*
   * PHORVA frontend API foundation.
   *
   * This layer talks to the existing PHORVA backend.
   * It does NOT replace or modify the security engine.
   */

  const PhorvaAPI = {
    async request(path, options = {}) {
      const response = await fetch(path, {
        ...options,
        headers: {
          "Content-Type": "application/json",
          ...(options.headers || {})
        }
      });

      let data = null;

      try {
        data = await response.json();
      } catch (_) {
        data = null;
      }

      if (!response.ok) {
        throw new Error(
          data?.error ||
          data?.message ||
          `PHORVA request failed (${response.status})`
        );
      }

      return data;
    },

    health() {
      return this.request("/health");
    },

    chains() {
      return this.request("/api/chains");
    },

    chainStatus() {
      return this.request("/chain-status");
    },

    providerStatus() {
      return this.request("/provider-status");
    },

    authorize(payload) {
      return this.request("/authorize", {
        method: "POST",
        body: JSON.stringify(payload)
      });
    },

    transaction(chain, hash) {
      return this.request(
        `/transaction/${encodeURIComponent(chain)}/${encodeURIComponent(hash)}`
      );
    },

    decodeTransaction(chain, hash) {
      return this.request(
        `/decode-transaction/${encodeURIComponent(chain)}/${encodeURIComponent(hash)}`
      );
    }
  };

  window.PhorvaAPI = PhorvaAPI;

  /*
   * Developer dashboard
   *
   * The Developer area is an entry point into the existing
   * public/developer application. We keep the developer console
   * separate from the end-user PHORVA execution UI.
   */
  function openDeveloperDashboard() {
    window.location.href = "/developer/";
  }

  document.addEventListener("click", (event) => {
    const consoleButton = event.target.closest(".developer-open-console");
    if (consoleButton) {
      event.preventDefault();
      openDeveloperDashboard();
      return;
    }

    const docsButton = event.target.closest(".developer-open-docs");
    if (docsButton) {
      event.preventDefault();

      const docsButtonTarget =
        document.querySelector('[data-view="docs"]');

      if (docsButtonTarget) {
        docsButtonTarget.click();
      }
    }
  });

  /*
   * Home live-status helper.
   * This only updates elements when the corresponding IDs exist,
   * so it is safe with the current UI.
   */
  async function refreshPhorvaStatus() {
    const engine = document.getElementById("phorvaEngineStatus");
    const chains = document.getElementById("phorvaChainStatus");
    const mode = document.getElementById("phorvaModeStatus");

    if (!engine && !chains && !mode) return;

    try {
      const [health, chainStatus] = await Promise.all([
        PhorvaAPI.health(),
        PhorvaAPI.chainStatus()
      ]);

      if (engine) {
        engine.textContent =
          health?.status === "running" ? "Online" : "Unavailable";
      }

      if (mode) {
        mode.textContent =
          health?.mode || "Connected";
      }

      if (chains) {
        const values = Object.values(chainStatus?.chains || {});
        const connected = values.filter(c => c.connected).length;

        chains.textContent =
          `${connected}/${values.length || 0} connected`;
      }
    } catch (error) {
      if (engine) engine.textContent = "Unavailable";
      if (chains) chains.textContent = "Unavailable";
      if (mode) mode.textContent = "Backend unavailable";

      console.warn("PHORVA status check failed:", error);
    }
  }

  window.refreshPhorvaStatus = refreshPhorvaStatus;

  /*
   * Refresh once on load and whenever the Home view becomes active.
   */
  refreshPhorvaStatus();

  document.addEventListener("click", (event) => {
    const homeButton = event.target.closest('[data-view="home"]');

    if (homeButton) {
      setTimeout(refreshPhorvaStatus, 50);
    }
  });
})();
</script>



<script id="phorva-navigation-fix-v2">
(() => {
  "use strict";

  function phorvaNavigate(id) {
    const target = document.getElementById(id);
    if (!target || !target.classList.contains("view")) return false;

    document.querySelectorAll(".view").forEach(view => {
      view.classList.toggle("active", view.id === id);
    });

    document.querySelectorAll(".nav[data-view]").forEach(nav => {
      nav.classList.toggle("active", nav.dataset.view === id);
    });

    const sheet = document.getElementById("sheet");
    if (sheet) sheet.classList.remove("open");

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

    if (id === "home" && typeof window.refreshPhorvaStatus === "function") {
      setTimeout(window.refreshPhorvaStatus, 50);
    }

    return true;
  }

  document.addEventListener("click", event => {
    const more = event.target.closest("#more");

    if (more) {
      event.preventDefault();
      event.stopImmediatePropagation();

      const sheet = document.getElementById("sheet");
      if (sheet) sheet.classList.add("open");

      return;
    }

    const button = event.target.closest("[data-view]");

    if (!button) return;

    const id = button.dataset.view;

    if (!id || id === "ask") return;

    if (document.getElementById(id)?.classList.contains("view")) {
      event.preventDefault();
      event.stopImmediatePropagation();
      phorvaNavigate(id);
    }
  }, true);

  window.PhorvaNavigate = phorvaNavigate;
})();
</script>

