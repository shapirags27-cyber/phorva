      action === "approve"
    ) {
      to = routers[chain];

      calldata =
        "0x095ea7b3" +
        address(routers[chain]) +
        word(amount);

    } else {
      /*
       * Preserve the existing PHORVA selector/function
       * model for the current demo verification path.
       */
      to = routers[chain];

      calldata =
        selector +
        word(amount) +
        word(Math.max(1, amount - 10)) +
        word(160) +
        address(
          "0x3333333333333333333333333333333333333333"
        ) +
        word(
          Math.floor(Date.now() / 1000) + 3600
        ) +
        word(2) +
        address(token) +
        address(
          "0x2222222222222222222222222222222222222222"
        );
    }

    return {
      agent,

      action: {
        type: action,
        chain,
        protocol,
        asset: assetValue,
        amount
      },

      policy: {
        maxTransactionAmount: maximum,
        dailyLimit: 2000
      },

      intent: {
        type: action,
        chain,
        protocol,
        asset: assetValue,
        amount
      },

      transaction: {
        from: wallet,
        to,
        chainId: chainIds[chain],
        expectedChainId: chainIds[chain],
        value: "0",
        calldata,
        amount
      }
    };
  }

  async function evaluate() {
    const button = el("evaluate");

    if (!button) return;

    button.disabled = true;
    button.textContent = "Checking…";

    set(
      "resultTitle",
      "PHORVA verification in progress"
    );

    set(
      "resultReason",
      "Checking policy, intent, parameters, protocol and transaction security…"
    );

    try {
      const payload = buildPayload();

      const data =
        await window.PhorvaAPI.authorize(payload);

      /*
       * Existing Agent result UI.
       */
      set(
        "resultTitle",
        data.authorized
          ? "Authorization approved"
          : "Authorization blocked"
      );

      set(
        "resultReason",
        data.reason || ""
      );

      set(
        "vPolicy",
        data.policyPassed
          ? "PASSED"
          : "FAILED"
      );

      set(
        "vIntent",
        data.intentMatched
          ? "MATCHED"
          : "MISMATCH"
      );

      set(
        "vParameters",
        data.parameterMatched
          ? "MATCHED"
          : "MISMATCH"
      );

      set(
        "vProtocol",
        data.protocolMatched
          ? "MATCHED"
          : "MISMATCH"
      );

      set(
        "vContract",
        data.verdict?.contract ||
        "UNKNOWN"
      );

      set(
        "vSecurity",
        data.transactionSecuritySafe
          ? "SAFE"
          : "THREAT DETECTED"
      );

      const proof =
        el("proofOutput");

      if (proof) {
        proof.textContent =
          JSON.stringify(
            data.proof || {},
            null,
            2
          );
      }

      /*
       * This is the bridge from Agent -> Home.
       */
      record(data, payload);

      /*
       * Refresh live backend state after verification.
       */
      if (
        typeof window.refreshPhorvaStatus ===
        "function"
      ) {
        window.refreshPhorvaStatus();
      }

    } catch (error) {
      console.error(
        "PHORVA authorization error:",
        error
      );

      set(
        "resultTitle",
        "Authorization request failed"
      );

      set(
        "resultReason",
        error.message ||
        "PHORVA backend unavailable."
      );

    } finally {
      button.disabled = false;
      button.textContent = "Evaluate Action";
    }
  }

  /*
   * Capture the click before any legacy UI-only handler.
   * This prevents duplicate /authorize calls if an older
   * handler is still present elsewhere in the file.
   */
  document.addEventListener(
    "click",
    event => {
      const button =
        event.target.closest("#evaluate");

      if (!button) return;

      event.preventDefault();
      event.stopImmediatePropagation();

      evaluate();
    },
    true
  );

  /*
   * Keep Agent metadata live when its chain changes.
   */
  document.addEventListener("change", event => {
    if (
      event.target?.id === "agentChain"
    ) {
      window.PhorvaLiveAgent?.loadMetadata();
    }
  });

  /*
   * Initial state.
   */
  renderHome();
  loadAgentMetadata();

  window.PhorvaLiveAgent = {
    loadMetadata: loadAgentMetadata,
    evaluate,
    buildPayload
  };

})();
</script>

</body>
</html>
