function getAgentSemanticFields(){
  const domain =
    document.getElementById("agentDomain")?.value || "";

  const action =
    document.getElementById("agentAction")?.value || "";

  const schema =
    AGENT_ACTION_FIELDS[domain]?.[action] || [];

  const fields = {};

  schema.forEach(([key]) => {
    const element =
      document.getElementById(`agentAction_${key}`);

    if(!element) return;

    fields[key] =
      element.value === undefined
        ? ""
        : String(element.value).trim();
  });

  return fields;
}

function buildAuthorizationRequest(){

  const get = id => {
    const element = document.getElementById(id);
    return element ? element.value.trim() : "";
  };

  const number = id => {
    const value = Number(get(id));
    return Number.isFinite(value) ? value : 0;
  };

  const agent = get("agentName");
  const wallet = get("agentWallet");
  const chainKey = get("agentChain");
  const domain = get("agentDomain");
  const action = get("agentAction");
  const protocol = get("agentProtocol");
  const asset = get("agentAsset");

  const selectedChain =
    chains.find(chain => chain.key === chainKey);

  const semantic =
    getAgentSemanticFields();

  const semanticText = key =>
    semantic[key] !== undefined
      ? String(semantic[key]).trim()
      : "";

  const semanticNumber = key => {
    const value =
      Number(semanticText(key));

    return Number.isFinite(value)
      ? value
      : 0;
  };

  const amountKeys = [
    "amount",
    "allowance"
  ];

  const amountKey =
    amountKeys.find(
      key => semanticText(key) !== ""
    );

  const amount =
    amountKey
      ? semanticNumber(amountKey)
      : 0;

  const maximum =
    number("policyMaximum");

  const recipient =
    semanticText("recipient");

  const spender =
    semanticText("spender");

  const target =
    semanticText("target") ||
    semanticText("contract");

  const tokenIn =
    semanticText("tokenIn");

  const tokenOut =
    semanticText("tokenOut");

  const minimumAmountOut =
    semanticNumber("amountOutMin");

  const destinationChain =
    semanticText("destinationChain");

  const bridge =
    semanticText("bridge");

  const functionName =
    semanticText("function");

  const selector =
    semanticText("selector");

  const parameters =
    semanticText("parameters");

  const normalizedAction =
    action === "approve"
      ? "approval"
      : action;

  const selectedAsset =
    (assets[chainKey] || []).find(
      item => String(item.address) === String(asset)
    ) ||
    (assets[chainKey] || []).find(
      item =>
        item.type === "native" &&
        (!asset || asset === "")
    );

  const isNativeAsset =
    selectedAsset?.type === "native" ||
    selectedAsset?.address === null;

  const isNativeSend =
    action === "send" &&
    isNativeAsset;

  const normalizedAsset =
    isNativeAsset
      ? ""
      : asset;

  const intent = {
    type: normalizedAction,
    domain,
    action,
    protocol,
    asset: normalizedAsset,
    assetAddress:
      isNativeAsset
        ? undefined
        : (asset || undefined),
    amount,
    chain: chainKey,
    chainId:
      selectedChain
        ? selectedChain.chainId
        : undefined,
    recipient:
      recipient || undefined,
    spender:
      spender || undefined,
    target:
      target || undefined,
    tokenIn:
      tokenIn || undefined,
    tokenOut:
      tokenOut || undefined,
    amountOutMin:
      action === "swap"
        ? minimumAmountOut
        : undefined,
    destinationChain:
      destinationChain || undefined,
    bridge:
      bridge || undefined,
    function:
      functionName || undefined,
    selector:
      selector || undefined,
    parameters:
      parameters || undefined,

    actionFields:
      semantic,
    nativeValue:
      isNativeSend
        ? String(amount)
        : "0"
  };

  const transaction = {
    chain: chainKey,
    chainId:
      selectedChain
        ? selectedChain.chainId
        : undefined,
    expectedChainId:
      selectedChain
        ? selectedChain.chainId
        : undefined,
    from: wallet,
    to:
      isNativeSend
        ? recipient
        : (target || undefined),
    value:
      isNativeSend
        ? String(amount)
        : "0",
    calldata:
      isNativeSend
        ? "0x"
        : (selector || "0x"),
    actionFields:
      semantic,
    destinationAllowed: true
  };

  return {
    agent: {
      id: agent,
      name: agent,
      wallet,
      address: wallet
    },

    action: {
      type: normalizedAction,
      name: functionName || action,
      domain,
      chain: chainKey,
      chainId:
        selectedChain
          ? selectedChain.chainId
          : undefined,
      protocol,
      asset: normalizedAsset,
      actionFields:
        semantic
    },

    intent,

    policy: {
      maxTransactionAmount: maximum,
      maxTransaction: maximum,
      allowedProtocols:
        protocol
          ? [protocol]
          : [],
      allowedChains: [chainKey]
    },

    transaction
  };
}

