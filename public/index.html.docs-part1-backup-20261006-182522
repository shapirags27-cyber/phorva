async function askAgentGuard(){

 const input =
   document.getElementById("askInput");

 const answer =
   document.getElementById("askAnswer");

 const question =
   input.value.trim().toLowerCase();

 if(!question){

   answer.textContent =
     "Ask a question about PHORVA.";

   answer.classList.add("show");

   return;

 }



 let response =
   "PHORVA is an execution-security and verification layer for autonomous agents. It evaluates declared intent, policy conditions, transaction parameters, protocol targeting and transaction-security checks before authorization.";



 if(question.includes("wallet")){

   response =
     "PHORVA is not a wallet and does not custody agent assets. The agent's wallet or signer remains external. PHORVA evaluates whether an intended execution is authorized before the agent proceeds to signing and blockchain execution.";

 }else if(question.includes("proof") || question.includes("verification")){

   response =
     "PHORVA's backend can generate authorization proof specifications, claims and commitments. It also exposes execution verification, verification traces and proof verification routes.";

 }else if(question.includes("policy")){

   response =
     "PHORVA policies can enforce transaction limits and execution conditions. During authorization, the backend evaluates the actual transaction against the supplied policy and returns the policy decision.";

 }else if(question.includes("intent")){

   response =
     "PHORVA compares an agent's declared intent with the actual blockchain execution, including action type, transaction parameters, native value, asset and protocol conditions.";

 }else if(question.includes("integrat")){
   response =
     "Agents integrate with PHORVA through its API or SDK layer. The integration sends execution context to PHORVA for verification and authorization while the agent's own wallet or signer remains external.";

 }else if(question.includes("zk") || question.includes("prover")){

   response =
     "PHORVA does not position itself as another prover network. PHORVA defines verification semantics and can use external proving or verification infrastructure where appropriate.";

 }else if(question.includes("security")){

   response =
     "PHORVA evaluates transaction-security conditions alongside policy, intent, parameter, protocol and execution checks. A transaction-security failure can cause authorization to be blocked.";

 }



 answer.textContent = response;

 answer.classList.add("show");

}



