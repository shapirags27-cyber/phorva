<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#101216">
<title>Phorva — Verifiable Execution</title>

<style>
:root{
 --bg:#0b0d11;
 --panel:#12161c;
 --panel2:#181e26;
 --line:#252c35;
 --text:#f4f6f8;
 --muted:#89929e;
 --accent:#6f8cff;
 --accent2:#9aaeff;
 --green:#58d49b;
 --red:#f06f82;
 --yellow:#e8c56b;
 --soft:rgba(111,140,255,.12);
 --shadow:0 24px 70px rgba(0,0,0,.28)
}

:root.light{
 --bg:#f5f7f9;
 --panel:#fff;
 --panel2:#eef1f5;
 --line:#dce2e8;
 --text:#171a20;
 --muted:#69727e;
 --accent:#516ee8;
 --accent2:#3f5dd3;
 --green:#27956a;
 --red:#d34f64;
 --yellow:#9b7b21;
 --soft:rgba(81,110,232,.1);
 --shadow:0 18px 50px rgba(20,25,35,.08)
}

*{box-sizing:border-box}

html{
 background:var(--bg);
 scroll-behavior:smooth
}

body{
 margin:0;
 background:var(--bg);
 color:var(--text);
 font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
 min-height:100vh
}

button,input,select{
 font:inherit;
 color:inherit
}

button{
 cursor:pointer
}

.app{
 min-height:100vh;
 padding-bottom:84px
}

.header{
 height:78px;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:0 28px;
 border-bottom:1px solid var(--line);
 background:rgba(11,13,17,.94);
 backdrop-filter:blur(18px);
 position:sticky;
 top:0;
 z-index:50
}

:root.light .header{
 background:rgba(245,247,249,.94)
}

.brand{
 display:flex;
 align-items:center;
 gap:12px;
 border:0;
 background:none
}

.brand img{
 width:42px;
 height:42px;
 padding:7px;
 border-radius:12px;
 background:#07090c;
 border:1px solid var(--line);
 object-fit:contain
}

.brand b{
 font-size:18px;
 letter-spacing:.12em
}

.header-actions{
 display:flex;
 align-items:center;
 gap:9px
}

.icon-btn,
.network{
 height:44px;
 border:1px solid var(--line);
 background:var(--panel);
 border-radius:12px
}

.icon-btn{
 width:44px
}

.network{
 padding:0 14px;
 font-size:12px;
 font-weight:800
}

.main{
 width:min(1180px,calc(100% - 40px));
 margin:auto;
 padding:30px 0
}

.view{
 display:none
}

.view.active{
 display:block
}

.kicker{
 color:var(--accent2);
 font-size:10px;
 letter-spacing:.17em;
 text-transform:uppercase;
 font-weight:900
}

.title{
 font-size:clamp(34px,5vw,52px);
 line-height:1;
 letter-spacing:-.045em;
 margin:10px 0 12px
}

.sub{
 color:var(--muted);
 line-height:1.65;
 max-width:760px
}

.card{
 border:1px solid var(--line);
 background:linear-gradient(145deg,var(--panel),var(--bg));
 border-radius:20px;
 box-shadow:var(--shadow);
 overflow:hidden
}

.pad{
 padding:22px
}

.hero{
 padding:34px;
 min-height:350px;
 background:
 radial-gradient(circle at 88% 0%,rgba(111,140,255,.2),transparent 34%),
 linear-gradient(145deg,var(--panel2),var(--panel))
}

.hero h1{
 max-width:780px;
 font-size:clamp(38px,6vw,62px);
 line-height:1;
 letter-spacing:-.055em;
 margin:14px 0 20px
}

.hero p{
 max-width:760px;
 color:var(--muted);
 line-height:1.7
}

.flow{
 display:flex;
 align-items:center;
 gap:8px;
 flex-wrap:wrap;
 margin-top:28px
}

.flow i{
 color:var(--muted);
 font-style:normal
}

.node{
 padding:10px 13px;
 border:1px solid var(--line);
 border-radius:10px;
 background:rgba(0,0,0,.12);
 font-size:10px;
 font-weight:850
}

.node.core{
 border-color:rgba(111,140,255,.5);
 background:var(--soft);
 color:var(--accent2)
}

.grid{
 display:grid;
 gap:16px
}

.stats{
 grid-template-columns:repeat(3,1fr);
 margin-top:18px
}

.two{
 grid-template-columns:1.3fr .7fr
}

.three{
 grid-template-columns:repeat(3,1fr)
}

.stat{
 padding:22px;
 min-height:145px
}

.label{
 color:var(--muted);
 font-size:10px;
 text-transform:uppercase;
 letter-spacing:.1em;
 font-weight:850
}

.value{
 font-size:30px;
 font-weight:900;
 margin-top:18px
}

.meta{
 color:var(--accent2);
 font-size:10px;
 margin-top:6px
}

.head{
 padding:18px 20px;
 border-bottom:1px solid var(--line);
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:12px
}

.head strong{
 font-size:14px
}

.muted{
 color:var(--muted);
 font-size:10px
}

.badge{
 padding:7px 10px;
 border-radius:999px;
 background:var(--soft);
 color:var(--accent2);
 font-size:9px;
 font-weight:900
}

.badge.green{
 background:rgba(88,212,155,.1);
 color:var(--green)
}

.badge.red{
 background:rgba(240,111,130,.1);
 color:var(--red)
}

.badge.yellow{
 background:rgba(232,197,107,.1);
 color:var(--yellow)
}

.activity{
 padding:10px 20px
}

.row{
 display:grid;
 grid-template-columns:36px 1fr auto;
 gap:12px;
 align-items:center;
 padding:14px 0;
 border-bottom:1px solid var(--line)
}

.row:last-child{
 border-bottom:0
}

.row-icon{
 width:36px;
 height:36px;
 border-radius:10px;
 background:var(--panel2);
 display:grid;
 place-items:center;
 color:var(--accent2)
}

.row strong{
 display:block;
 font-size:11px
}

.row span{
 display:block;
 color:var(--muted);
 font-size:9px;
 margin-top:4px
}

.time{
 color:var(--muted);
 font-size:9px
}

.field{
 border:1px solid var(--line);
 background:var(--panel2);
 border-radius:13px;
 padding:15px
}

.field small{
 display:block;
 color:var(--muted);
 font-size:9px;
 text-transform:uppercase;
 letter-spacing:.1em
}

.field b{
 display:block;
 font-size:12px;
 margin-top:7px
}

.field input,
.field select{
 width:100%;
 margin-top:8px;
 background:transparent;
 border:0;
 outline:0;
 font-weight:750
}

.fields{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px;
 padding:20px
}

.full{
 grid-column:1/-1
}

.primary{
 width:calc(100% - 40px);
 margin:0 20px 10px;
 padding:15px;
 border:0;
 border-radius:13px;
 background:var(--accent);
 color:#fff;
 font-weight:900
}

.primary:disabled{
 opacity:.5;
 cursor:not-allowed
}

.note{
 text-align:center;
 color:var(--muted);
 font-size:9px;
 padding:0 20px 18px
}

.preview{
 margin:0 20px 20px;
 padding:14px;
 border:1px solid var(--line);
 border-radius:14px;
 background:var(--bg)
}

.preview div{
 display:flex;
 justify-content:space-between;
 padding:10px 0;
 border-bottom:1px solid var(--line);
 font-size:10px;
 gap:15px
}

.preview div:last-child{
 border:0
}

.preview span{
 color:var(--muted)
}

.result{
 margin:0 20px 20px;
 padding:18px;
 border-radius:15px;
 border:1px solid var(--line);
 background:var(--bg);
 display:none
}

.result.show{
 display:block
}

.result-title{
 font-weight:900;
 font-size:18px
}

.result pre{
 white-space:pre-wrap;
 overflow:auto;
 color:var(--muted);
 font-size:10px;
 line-height:1.55;
 margin:15px 0 0
}

.verdict-grid{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:10px;
 margin-top:15px
}

.verdict{
 padding:13px;
 border:1px solid var(--line);
 border-radius:12px;
 background:var(--panel2)
}

.verdict small{
 display:block;
 color:var(--muted);
 font-size:8px;
 text-transform:uppercase
}

.verdict b{
 display:block;
 margin-top:6px;
 font-size:11px
}

.ok{
 color:var(--green)
}

.bad{
 color:var(--red)
}

.agent{
 display:grid;
 grid-template-columns:.7fr 1.3fr;
 gap:16px;
 margin-top:24px
}

.agent-menu{
 padding:10px
}

.agent-menu button{
 display:block;
 width:100%;
 text-align:left;
 border:1px solid transparent;
 background:none;
 border-radius:12px;
 padding:14px
}

.agent-menu button.active{
 background:var(--soft);
 border-color:rgba(111,140,255,.2)
}

.agent-menu strong{
 font-size:12px
}

.agent-menu span{
 display:block;
 color:var(--muted);
 font-size:10px;
 margin-top:4px
}

.guard-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px;
 padding:20px
}

.guard-item{
 padding:17px;
 border:1px solid var(--line);
 border-radius:14px;
 background:var(--panel2)
}

.guard-item b{
 font-size:12px
}

.guard-item p{
 color:var(--muted);
 font-size:10px;
 line-height:1.5;
 margin:7px 0 0
}

.status{
 float:right;
 width:8px;
 height:8px;
 border-radius:50%;
 background:var(--green);
 box-shadow:0 0 9px var(--green)
}

.docs{
 display:grid;
 grid-template-columns:240px 1fr;
 gap:16px;
 margin-top:24px
}

.docs-nav{
 padding:12px
}

.docs-nav button{
 width:100%;
 text-align:left;
 padding:12px;
 border:0;
 background:none;
 border-radius:10px
}

.docs-nav button.active{
 background:var(--soft);
 color:var(--accent2)
}

.docs-content{
 padding:30px
}

.docs-content h2{
 font-size:30px;
 margin:0 0 12px
}

.docs-content h3{
 margin-top:28px
}

.docs-content p,
.docs-content li{
 color:var(--muted);
 line-height:1.7;
 font-size:13px
}

.code{
 padding:16px;
 border:1px solid var(--line);
 background:#080a0e;
 border-radius:12px;
 overflow:auto;
 color:#cbd5e1;
 font-size:11px;
 line-height:1.6
}

.ask{
 display:grid;
 grid-template-columns:1fr auto;
 gap:10px;
 margin-top:20px
}

.ask input{
 min-width:0;
 padding:15px;
 border:1px solid var(--line);
 background:var(--panel2);
 border-radius:12px;
 outline:0
}

.ask button{
 border:0;
 background:var(--accent);
 color:#fff;
 border-radius:12px;
 padding:0 20px;
 font-weight:850
}

.ask-answer{
 margin-top:14px;
 padding:18px;
 border:1px solid var(--line);
 border-radius:14px;
 background:var(--panel2);
 color:var(--muted);
 line-height:1.65;
 font-size:12px;
 display:none
}

.ask-answer.show{
 display:block
}

.placeholder{
 min-height:230px;
 display:grid;
 place-items:center;
 text-align:center;
 padding:30px
}

.placeholder p{
 color:var(--muted);
 max-width:520px;
 line-height:1.6;
 font-size:11px
}

.bottom{
 position:fixed;
 left:0;
 right:0;
 bottom:0;
 height:78px;
 background:rgba(11,13,17,.96);
 border-top:1px solid var(--line);
 z-index:60;
 display:grid;
 grid-template-columns:repeat(5,1fr);
 padding:6px 10px
}

:root.light .bottom{
 background:rgba(245,247,249,.96)
}

.nav{
 border:0;
 background:none;
 color:var(--muted);
 display:flex;
 flex-direction:column;
 align-items:center;
 justify-content:center;
 gap:4px;
 border-radius:12px
}

.nav.active{
 color:var(--accent2);
 background:var(--soft)
}

.nav .ico{
 font-size:20px
}

.nav small{
 font-size:9px;
 font-weight:800
}

.sheet{
 position:fixed;
 inset:0;
 background:rgba(0,0,0,.6);
 backdrop-filter:blur(8px);
 z-index:100;
 display:none
}

.sheet.open{
 display:block
}

.panel{
 position:absolute;
 right:0;
 top:0;
 height:100%;
 width:min(440px,100%);
 background:var(--bg);
 border-left:1px solid var(--line);
 padding:28px;
 overflow:auto
}

.close{
 float:right;
 border:0;
 background:none;
 font-size:30px;
 color:var(--muted)
}

.more-title{
 font-size:30px;
 font-weight:900;
 margin:48px 0 24px
}

.menu{
 display:grid;
 gap:4px
}

.menu button{
 border:0;
 background:none;
 text-align:left;
 padding:14px 8px;
 border-radius:11px;
 display:flex;
 align-items:center;
 gap:14px
}

.menu button:hover{
 background:var(--panel)
}

.mi{
 width:28px;
 text-align:center;
 color:var(--muted);
 font-size:18px
}

.menu b{
 font-size:13px
}

.divider{
 height:1px;
 background:var(--line);
 margin:17px 0
}

@media(max-width:800px){

 .header{
  height:78px;
  padding:0 14px
 }

 .brand img{
  width:42px;
  height:42px
 }

 .brand b{
  font-size:16px
 }

 .network{
  display:none
 }

 .main{
  width:calc(100% - 24px);
  padding:24px 0 30px
 }

 .hero{
  padding:25px
 }

 .hero h1{
  font-size:42px
 }

 .flow{
  flex-wrap:nowrap;
  overflow:auto;
  padding-bottom:4px
 }

 .node{
  flex:0 0 auto
 }

 .stats,
 .two,
 .three,
 .agent,
 .docs{
  grid-template-columns:1fr
 }

 .fields{
  grid-template-columns:1fr
 }

 .full{
  grid-column:auto
 }

 .guard-grid{
  grid-template-columns:1fr
 }

 .verdict-grid{
  grid-template-columns:1fr 1fr
 }

 .bottom{
  height:88px
 }

 .nav{
  min-height:76px
 }

 .nav .ico{
  font-size:25px
 }

 .nav small{
  font-size:10px
 }

 .docs-content{
  padding:22px
 }
}

@media(max-width:500px){

 .title{
  font-size:36px
 }

 .hero h1{
  font-size:36px
 }

 .brand b{
  display:none
 }

 .verdict-grid{
  grid-template-columns:1fr
 }

 .ask{
  grid-template-columns:1fr
 }

 .ask button{
  min-height:48px
 }
}

/* =========================================================
   PHORVA HOME DASHBOARD
   Presentation only — existing backend/security logic preserved.
   ========================================================= */

.home-shell{
  width:100%;
  max-width:1180px;
  margin:0 auto;
  display:flex;
  flex-direction:column;
  gap:18px;
}

.home-hero{
  position:relative;
  overflow:hidden;
  padding:42px;
  border:1px solid var(--border);
  border-radius:24px;
  background:
    radial-gradient(circle at 80% 0%, rgba(80,90,220,.16), transparent 38%),
    linear-gradient(145deg, rgba(255,255,255,.035), rgba(255,255,255,.012));
}

.home-hero:after{
  content:"";
  position:absolute;
  width:260px;
  height:260px;
  right:-120px;
  bottom:-150px;
  border-radius:50%;
  background:rgba(76,82,220,.08);
  filter:blur(35px);
  pointer-events:none;
}

.home-hero h1{
  max-width:760px;
  margin:7px 0 14px;
  font-size:clamp(38px,6vw,72px);
  line-height:.98;
  letter-spacing:-.055em;
}

.home-hero p{
  max-width:720px;
  margin:0;
  color:var(--muted);
  font-size:16px;
  line-height:1.7;
}

.home-actions{
  display:flex;
  gap:10px;
  margin-top:26px;
}

.home-flow{
  position:relative;
  z-index:1;
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:8px;
  margin-top:34px;
}

.flow-node{
  padding:8px 12px;
  border:1px solid var(--border);
  border-radius:9px;
  background:rgba(255,255,255,.025);
  color:var(--muted);
  font-size:12px;
  white-space:nowrap;
}

.flow-node.core{
  color:var(--text);
  border-color:rgba(120,125,255,.38);
  background:rgba(85,90,220,.09);
}

.home-flow i{
  color:var(--muted);
  font-style:normal;
}

.home-status-grid,
.home-metrics{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.home-status-card{
  min-height:128px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.home-status-card .value{
  margin:7px 0 3px;
  font-size:25px;
  font-weight:700;
  letter-spacing:-.025em;
}

.analyzer-value{
  font-size:18px!important;
}

.home-metric{
  display:flex;
  align-items:center;
  gap:15px;
  min-height:118px;
}

.metric-icon{
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  flex:none;
  border:1px solid var(--border);
  border-radius:12px;
  background:rgba(255,255,255,.025);
  font-size:18px;
}

.metric-value{
  margin-top:4px;
  font-size:30px;
  line-height:1;
  font-weight:750;
  letter-spacing:-.04em;
}

.home-main-grid{
  display:grid;
  grid-template-columns:minmax(0,1.35fr) minmax(320px,.85fr);
  gap:18px;
}

.home-control-card,
.home-verification-card,
.home-activity-card{
  min-width:0;
}

.control-pipeline{
  margin-top:20px;
}

.control-step{
  display:flex;
  align-items:flex-start;
  gap:14px;
}

.control-step>span{
  width:30px;
  height:30px;
  display:grid;
  place-items:center;
  flex:none;
  border:1px solid var(--border);
  border-radius:9px;
  color:var(--muted);
  font-size:10px;
  font-weight:700;
}

.control-step strong{
  display:block;
  margin-bottom:4px;
}

.control-step small{
  display:block;
  color:var(--muted);
  line-height:1.5;
}

.pipeline-line{
  height:22px;
  width:1px;
  margin-left:14px;
  background:var(--border);
}

.verification-state{
  margin-top:18px;
}

.state-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  padding:15px 0;
  border-bottom:1px solid var(--border);
}

.state-row:last-child{
  border-bottom:0;
}

.state-row small{
  display:block;
  color:var(--muted);
  margin-bottom:5px;
}

.state-row span{
  font-size:14px;
  font-weight:600;
}

.state-row>b{
  font-size:10px;
  opacity:.75;
}

.home-note{
  margin-top:10px;
  padding:12px;
  border:1px solid var(--border);
  border-radius:10px;
  color:var(--muted);
  font-size:12px;
  line-height:1.55;
}

.home-activity-card .head{
  align-items:center;
}

.small-action{
  padding:8px 11px!important;
  font-size:12px!important;
}

.home-empty{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:7px;
  min-height:190px;
  text-align:center;
  color:var(--muted);
}

.home-empty-icon{
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  margin-bottom:5px;
  border:1px solid var(--border);
  border-radius:12px;
}

.home-empty strong{
  color:var(--text);
}

.home-empty span{
  max-width:390px;
  line-height:1.5;
}

.home-empty button{
  margin-top:9px;
}

.home-footer-card{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
  padding:28px 30px;
  border:1px solid var(--border);
  border-radius:20px;
  background:
    linear-gradient(135deg,rgba(80,90,220,.09),rgba(255,255,255,.015));
}

.home-footer-card h2{
  max-width:650px;
  margin:5px 0 8px;
  font-size:23px;
  letter-spacing:-.025em;
}

.home-footer-card p{
  max-width:680px;
  margin:0;
  color:var(--muted);
  line-height:1.55;
  font-size:13px;
}

@media(max-width:850px){
  .home-hero{
    padding:28px 22px;
    border-radius:18px;
  }

  .home-hero h1{
    font-size:42px;
  }

  .home-status-grid,
  .home-metrics,
  .home-main-grid{
    grid-template-columns:1fr;
  }

  .home-footer-card{
    align-items:flex-start;
    flex-direction:column;
    padding:24px;
  }
}

@media(max-width:600px){
  .home-shell{
    gap:13px;
  }

  .home-hero{
