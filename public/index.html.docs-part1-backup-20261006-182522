function renderAgentActionFields(){

  const domain =
    document.getElementById("agentDomain").value;

  const action =
    document.getElementById("agentAction").value;

  const container =
    document.getElementById("agentActionFields");

  if(!container) return;

  container.innerHTML = "";

  const title =
    document.createElement("div");

  title.className = "muted";
  title.textContent =
    domain.replace(/-/g, " ") +
    " → " +
    action.replace(/-/g, " ");

  container.appendChild(title);

  const fields =
    document.createElement("div");

  fields.className = "fields";

  const definitions =
    AGENT_ACTION_FIELDS[domain]?.[action] || [];

  definitions.forEach(
    ([id,label,type,value]) => {

      const field =
        document.createElement("div");

      field.className = "field";

      const small =
        document.createElement("small");

      small.textContent = label;

      let input;

      if(type === "select"){

        input =
          document.createElement("select");

        if(id === "destinationChain"){

          [
            ["", "Select destination chain"],
            ["baseSepolia", "Base Sepolia"],
            ["ethereumSepolia", "Ethereum Sepolia"],
            ["arbitrumSepolia", "Arbitrum Sepolia"]
          ].forEach(
            ([optionValue,optionText]) => {

              const option =
                document.createElement("option");

              option.value = optionValue;
              option.textContent = optionText;

              input.appendChild(option);
            }
          );

        }else if(id === "vote"){

          [
            ["", "Select vote"],
            ["for", "For"],
            ["against", "Against"],
            ["abstain", "Abstain"]
          ].forEach(
            ([optionValue,optionText]) => {

              const option =
                document.createElement("option");

              option.value = optionValue;
              option.textContent = optionText;

              input.appendChild(option);
            }
          );
        }

      }else{

        input =
          document.createElement("input");

        input.type = type;
        input.value = value;
      }

      input.id =
        "agentAction_" + id;

      field.appendChild(small);
      field.appendChild(input);
      fields.appendChild(field);
    }
  );

  container.appendChild(fields);

  const policy =
    document.createElement("div");

  policy.className = "fields";

  const policyField =
    document.createElement("div");

  policyField.className = "field";

  const policyLabel =
    document.createElement("small");

  policyLabel.textContent =
    "Policy Maximum";

  const policyInput =
    document.createElement("input");

  policyInput.id = "policyMaximum";
  policyInput.type = "number";
  policyInput.value = "500";

  policyField.appendChild(policyLabel);
  policyField.appendChild(policyInput);
  policy.appendChild(policyField);

  container.appendChild(policy);
}

