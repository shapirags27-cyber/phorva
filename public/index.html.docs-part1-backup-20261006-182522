function syncAgentProtocolWithAsset(){

 const chain =
   document.getElementById("agentChain").value;

 const domain =
   document.getElementById("agentDomain")?.value;

 const action =
   document.getElementById("agentAction")?.value;

 const assetValue =
   document.getElementById("agentAsset").value;

 const protocolSelect =
   document.getElementById("agentProtocol");

 if(!protocolSelect) return;

 const rule =
   AGENT_CONTEXT_RULES[domain]?.[action] ||
   {protocol:false,asset:false};

 if(!rule.protocol){

   protocolSelect.disabled = true;
   protocolSelect.innerHTML = "";

   return;
 }

 protocolSelect.disabled = false;

 /*
  * Native is a protocol value only for a direct
  * native-asset send. Other protocol-aware actions
  * must keep their registered protocol context.
  */
 const isNativeSend =
   domain === "general" &&
   action === "send" &&
   (!assetValue || assetValue === "null");

 if(isNativeSend){

   protocolSelect.innerHTML = "";

   const option =
     document.createElement("option");

   option.value = "Native";
   option.textContent = "Native";

   protocolSelect.appendChild(option);
   protocolSelect.value = "Native";

   return;
 }

 const selectedAsset =
   (assets[chain] || []).find(
     item =>
       String(item.address) === String(assetValue)
   );

 const registeredProtocol =
   selectedAsset?.protocol || null;

 const list =
   protocols[chain] || [];

 const contextualList =
   registeredProtocol
     ? list.filter(
         protocol =>
           protocol === registeredProtocol
       )
     : list;

 protocolSelect.innerHTML = "";

 contextualList.forEach(protocol => {

   const option =
     document.createElement("option");

   option.value = protocol;
   option.textContent = protocol;

   protocolSelect.appendChild(option);

 });

 if(!contextualList.length){

   const option =
     document.createElement("option");

   option.value = "";
   option.textContent =
     "No registered protocol";

   protocolSelect.appendChild(option);

 }

}


function updateAssets(){

 const chain =
   document.getElementById("agentChain").value;

 const select =
   document.getElementById("agentAsset");

 if(!select) return;

 const rule =
   getAgentContextRule();

 select.innerHTML = "";

 const mode =
   rule.asset || "none";

 if(mode === "none"){

   select.disabled = true;

   syncAgentProtocolWithAsset();

   return;
 }

 select.disabled = false;

 const list =
   assets[chain] || [];

 const filtered =
   mode === "native"
     ? list.filter(
         asset => asset.type === "native"
       )
     : mode === "token"
       ? list.filter(
           asset => asset.type === "erc20"
         )
       : list;

 filtered.forEach(asset => {

   const option =
     document.createElement("option");

   option.value =
     asset.address === null
       ? "null"
       : asset.address;

   option.textContent =
     `${asset.symbol || asset.name} — ${asset.name || ""}`;

   option.dataset.assetType =
     asset.type || "";

   select.appendChild(option);

 });

 if(!filtered.length){

   const option =
     document.createElement("option");

   option.value = "";

   option.textContent =
     mode === "native"
       ? "No registered native asset"
       : mode === "token"
         ? "No registered token"
         : "No registered asset";

   select.appendChild(option);

 }

 syncAgentProtocolWithAsset();
}


