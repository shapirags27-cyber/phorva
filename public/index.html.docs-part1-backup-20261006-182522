    const n = BigInt(
      Math.max(0, Math.floor(Number(value) || 0))
    );

    return n.toString(16).padStart(64, "0");
  }

  function address(value) {
    return String(value || "")
      .replace(/^0x/i, "")
      .padStart(64, "0")
      .slice(-64);
  }

